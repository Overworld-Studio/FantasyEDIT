{
  "schemaVersion": 1,
  "id": "fantasy_edit",
  "version": "${version}",
  "name": "Fantasy:EDIT",
  "description": "虚空造物引擎：游戏内动态创建自定义物品/方块，支持 Blockbench 模型热加载。",
  "authors": [
    "lively-Studio"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.fantasy.edit.FantasyEdit"
    ],
    "client": [
      "com.fantasy.edit.client.FantasyEditClient"
    ]
  },
  "mixins": [
    {
      "config": "fantasy_edit.mixins.json",
      "environment": "client"
    },
    {
      "config": "fantasy_edit.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "java": ">=25"
  }
}
